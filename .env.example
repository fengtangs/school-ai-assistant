# ===== 大模型后端选择 =====
# ollama （默认）：调用本地/局域网 Ollama，无需 API Key，推荐校内部署使用
# deepseek：调用 DeepSeek 官方 API（需填下面的 DEEPSEEK_API_KEY）
LLM_PROVIDER=ollama

# ===== Ollama 本地模型配置（LLM_PROVIDER=ollama 时生效）=====
# Ollama 的 OpenAI 兼容接口地址（注意结尾的 /v1）
OLLAMA_BASE_URL=http://192.168.1.103:11434/v1
# 本地已部署的模型名（ollama list 可查看），例如 gpt-oss:20b
OLLAMA_MODEL=gpt-oss:20b

# ===== DeepSeek 大模型配置（LLM_PROVIDER=deepseek 时生效）=====
# 在 https://platform.deepseek.com 注册后获取 API Key
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 可选：deepseek-chat（通用）或 deepseek-reasoner（深度推理）
DEEPSEEK_MODEL=deepseek-chat

# 生成回答的最大 token 数（本地 14B 模型建议适当调大，避免被截断）
LLM_MAX_TOKENS=2048

# ===== 向量嵌入配置 =====
# mock：无需下载模型，开箱即用（适合演示/无网络环境）
# hf  ：使用真实中文向量模型 BAAI/bge-small-zh-v1.5（生产推荐）
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ===== 学校信息（可改成你的学校）=====
SCHOOL_NAME=德州工程职业学院

# ===== 索引与检索参数 =====
# 文档切分长度与重叠
CHUNK_SIZE=500
CHUNK_OVERLAP=100
# 每次检索返回的片段数
TOP_K=4

# 索引存储路径（自动生成，无需修改）
CHROMA_PATH=data/processed
# 原始文档目录
DATA_DIR=data/raw
