# ===== 大模型后端选择 =====
# ollama  ：调用本地/局域网 Ollama，无需 API Key，推荐校内部署使用
# deepseek：调用 DeepSeek 官方 API（需填下面的 DEEPSEEK_API_KEY）
# custom  ：调用任意 OpenAI 兼容的第三方网关（需填下面的 CUSTOM_API_KEY）
LLM_PROVIDER=ollama

# ===== 自定义 OpenAI 兼容网关（LLM_PROVIDER=custom 时生效）=====
# 默认对接「山东省综合金融服务平台智算服务专区」
# 换其他网关（阿里百炼 / 硅基流动 / 火山方舟等）只需改 BASE_URL 与 MODEL
CUSTOM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CUSTOM_BASE_URL=https://www.tokensd.com.cn/v1
# 常用可选模型：deepseek-v4-flash（快）、deepseek-v4-pro（强推理）、
#              glm-5.3、kimi-k2.7、qwen3.7-max 等
# 查看全部可用模型：python -c "from core.llm import list_custom_models; print(list_custom_models())"
CUSTOM_MODEL=deepseek-v4-flash

# ===== Ollama 本地模型配置（LLM_PROVIDER=ollama 时生效）=====
# Ollama 的 OpenAI 兼容接口地址（注意结尾的 /v1）
OLLAMA_BASE_URL=http://192.168.1.103:11434/v1
# 本地已部署的模型名（ollama list 可查看），例如 gpt-oss:20b
OLLAMA_MODEL=gpt-oss:20b

# ===== DeepSeek 大模型配置（LLM_PROVIDER=deepseek 时生效）=====
# 在 https://platform.deepseek.com 注册后获取 API Key
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 可选：deepseek-chat（通用）或 deepseek-reasoner（深度推理）
DEEPSEEK_MODEL=deepseek-chat

# 生成回答的最大 token 数
# ⚠️ deepseek-v4-* 等思考型模型会先消耗 reasoning token：
#    该值过小会出现「思考完了但正式回答为空」，建议 4096 以上
LLM_MAX_TOKENS=4096

# 教师材料生成 / AI 出题用的 token 上限
# 课件页数多、每页要点详实，输出 JSON 很长；加上思考型模型的 reasoning 开销，
# 该值偏小会导致「正文被截断」或「JSON 不完整」。建议 16384。
TEACHER_MAX_TOKENS=16384

# ===== 向量嵌入配置 =====
# mock  ：无需下载模型、无需联网，开箱即用；但只是字符重合度匹配，语义检索较差（演示用）
# custom：调用远程 OpenAI 兼容 /embeddings 接口（推荐，语义检索准确）
#         复用上面的 CUSTOM_API_KEY / CUSTOM_BASE_URL
# hf    ：本地 sentence-transformers 中文向量模型（需下载权重，约 130MB）
#
# 实测建议用 custom：mock 是哈希字符匹配，同一个问题换种说法就召不回正确片段，
# 表现为「资料里明明写了，助手却说没有」。
EMBEDDING_PROVIDER=custom

# custom embedding 的模型名（EMBEDDING_PROVIDER=custom 时生效）
# lucion-qwen3-embedding-8b → 4096 维；也可填该网关其他 embedding 模型
CUSTOM_EMBEDDING_MODEL=lucion-qwen3-embedding-8b
# 单批送向量的文本条数（太大可能触发网关限制）
EMBEDDING_BATCH_SIZE=32

# hf 模式下的本地模型名（EMBEDDING_PROVIDER=hf 时生效）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ⚠️ 切换 EMBEDDING_PROVIDER 会改变向量维度（mock=512 / custom=4096），
#    **切换后必须重建索引**，否则会报 StaleIndexError：
#    python scripts/build_index.py

# ===== 学校信息（可改成你的学校）=====
SCHOOL_NAME=德州工程职业学院

# ===== 索引与检索参数 =====
# 文档切分长度与重叠
# 学校 FAQ 类资料（一问一答）用 300/60 更准：片段短、一个片段基本对应一个问答，
# 500/100 会把多个问答揉在一起，检索时容易连带无关内容。
CHUNK_SIZE=300
CHUNK_OVERLAP=60
# 每次检索返回的片段数
TOP_K=4

# 索引存储路径（自动生成，无需修改）
CHROMA_PATH=data/processed
# 原始文档目录
DATA_DIR=data/raw
